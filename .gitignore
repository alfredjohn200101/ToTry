node_modules/
www/
.DS_Store
*.log
scratchpad/

# iOS native project IS tracked (hand-crafted App Store config: icon, privacy manifest,
# permissions can't be regenerated) — but keep the regenerable build junk out.
ios/App/Pods/
ios/App/App/public/
ios/App/build/
ios/DerivedData/
ios/App/output/
ios/capacitor-cordova-ios-plugins/
**/*.xcworkspace/xcuserdata/
**/*.xcodeproj/xcuserdata/
**/*.xcodeproj/project.xcworkspace/xcuserdata/

# Xcode build artifacts
build/

# Recorded UGC clips and their raw frames — regenerable output of scripts/record-reels.js, and large
# (~80MB a run). One stray webm was committed by accident in v371; see the note in that script.
recordings/
.ios-shots/

# Agent and probe scratch files. These are written into test/ by concurrent review agents, and
# a `git add -A` during a live run swept eight of them into a commit on 7 Oct 2026.
test/_*.tmp.js
test/_*.tmp.mjs

# Review-agent scratch. Agents work in the repo, not a sandbox — this directory
# exists so `git add -A` cannot sweep their probes into a commit again.
.tmp-review/

# Agent scratch. Three separate review rounds have written throwaway files into this repo
# (test/_probe39.js, .tmp-review/, x/fns.ts) and `git add -A` swept two of them into commits whose
# subject was something else. A rule nobody can forget beats a rule written down three times.
x/
.tmp-review/
