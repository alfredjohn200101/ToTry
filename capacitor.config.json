{
  "appId": "app.totry",
  "appName": "ToTry",
  "webDir": "www",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#0a0a0f",
    "zoomEnabled": true
  },
  "android": {
    "backgroundColor": "#0a0a0f"
  },
  "plugins": {
    "LocalNotifications": {
      "smallIcon": "ic_stat_icon",
      "iconColor": "#C8A96E"
    },
    "SplashScreen": {
      "launchShowDuration": 3000,
      "launchAutoHide": false,
      "showSpinner": false,
      "iosSpinnerStyle": "small",
      "splashFullScreen": true,
      "splashImmersive": false
    }
  }
}